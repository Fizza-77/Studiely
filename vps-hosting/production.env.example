# Copy to /var/www/studiely/.env.production (chmod 600) before npm run build on the VPS.
# Lines are KEY=value — no "export " prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.studiely.com

# If Flutter /app/ is hosted elsewhere after leaving Firebase, set its origin (no trailing slash).
# NEXT_PUBLIC_STUDIELY_APP_ORIGIN=https://app.studiely.com

# Optional: while running merge with USE_MERGE=1 before DNS cutover, pull preserved paths from old host.
# PRESERVE_SYNC_ORIGIN=https://www.studiely.com
