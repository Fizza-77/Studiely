{
  "hosting": {
    "public": "deploy",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blog/full/:slug",
        "destination": "/blog/:slug",
        "type": 301
      },
      {
        "source": "/pricing",
        "destination": "/app/pricing",
        "type": 301
      },
      {
        "source": "/pricing/",
        "destination": "/app/pricing",
        "type": 301
      },
      {
        "source": "/app/exam-practice",
        "destination": "/app/exampractice",
        "type": 301
      },
      {
        "source": "/app/exam-practice/",
        "destination": "/app/exampractice",
        "type": 301
      },
      {
        "source": "/app/price",
        "destination": "/app/pricing",
        "type": 301
      },
      {
        "source": "/app/price/",
        "destination": "/app/pricing",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2|jpg|jpeg|png|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/app/pricing",
        "destination": "/app/pricing.html"
      },
      {
        "source": "/app/pricing/",
        "destination": "/app/pricing.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ]
  }
}
